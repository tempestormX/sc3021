   ],
   "source": [
    "gas_cols = [col for col in ds3.columns if col not in ['country', 'year', 'sector']]\n",
    "\n",
    "n = len(gas_cols)\n",
    "ncols = 3\n",
    "nrows = (n + ncols - 1) // ncols\n",
    "\n",
    "fig, axs = plt.subplots(nrows, ncols, figsize=(18, 4 * nrows))\n",
    "axs = axs.flatten()\n",
    "\n",
    "\n",
    "for i, gas in enumerate(gas_cols):\n",
    "    ax = axs[i]\n",
    "\n",
    "    for sector in ds3['sector'].unique():\n",
    "        df_sector = ds3[ds3['sector'] == sector]\n",
    "\n",
    "        missing = df_sector.groupby('year')[gas].apply(\n",
    "            lambda x: (x.isna() | (x == 0)).sum()\n",
    "        )\n",
    "\n",
    "        ax.plot(missing.index, missing.values, label=sector)\n",
    "\n",
    "    ax.set_title(gas)\n",
    "    ax.set_xlabel(\"Year\")\n",
    "    ax.set_ylabel(\"Missing Count\")\n",
    "    ax.grid(True, alpha=0.3)\n",
    "\n",
    "for j in range(i + 1, len(axs)):\n",
    "    fig.delaxes(axs[j])\n",
    "\n",
    "handles, labels = axs[0].get_legend_handles_labels()\n",
    "fig.legend(handles, labels, loc='upper right', bbox_to_anchor=(1.1, 1))\n",
    "plt.suptitle(\"Missing Data Count per Sector for Each Gas\", fontsize=16)\n",
    "plt.tight_layout()\n",
