   "source": [
    "# Outlier summary by numeric column (IQR method) + plot\n",
    "numeric_cols = weather.select_dtypes(include=\"number\").columns\n",
    "\n",
    "outlier_stats = []\n",
    "for col in numeric_cols:\n",
    "    s = weather[col].dropna()\n",
    "    if s.empty:\n",
    "        continue\n",
    "\n",
    "    q1, q3 = s.quantile([0.25, 0.75])\n",
    "    iqr = q3 - q1\n",
    "\n",
    "    # If no spread, mark 0 outliers\n",
    "    if iqr == 0:\n",
    "        outlier_count = 0\n",
    "        outlier_percent = 0.0\n",
    "    else:\n",
    "        lower = q1 - 1.5 * iqr\n",
    "        upper = q3 + 1.5 * iqr\n",
    "        outlier_count = ((s < lower) | (s > upper)).sum()\n",
    "        outlier_percent = outlier_count / len(s) * 100\n",
    "\n",
    "    outlier_stats.append({\n",
    "        \"column\": col,\n",
    "        \"non_null_count\": len(s),\n",
    "        \"outlier_count\": int(outlier_count),\n",
    "        \"outlier_percent\": outlier_percent\n",
    "    })\n",
    "\n",
    "outlier_df = pd.DataFrame(outlier_stats).sort_values(\"outlier_percent\", ascending=False)\n",
    "display(outlier_df)\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.barh(outlier_df[\"column\"], outlier_df[\"outlier_percent\"])\n",
    "plt.gca().invert_yaxis()\n",
    "plt.xlabel(\"Outlier Percentage (%)\")\n",
    "plt.ylabel(\"Numeric Column\")\n",
    "plt.title(\"Outlier Percentage by Weather Variable (IQR Method)\")\n",
    "plt.grid(axis=\"x\", alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "We check for outliers in each of the weather attributes. This helps us identify any extreme values that may need to be handled before analysis. We see that snow depth and precipitation have some extreme values (around 20%), which can be consider normal for these attributes, as they can have significant variability. However, we will keep this in mind when performing our analysis and consider using robust statistical methods that are less sensitive to outliers if necessary."
   ]
  },
