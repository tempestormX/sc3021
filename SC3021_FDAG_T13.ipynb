   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Even after grouping, we still see that most categories have a lot of missing data. This makes it difficult to use this dataset for our analysis, as we cannot be sure if the missing data is true zeros or just missing records. Even if it is true zeros, the number of remaining records is still quite low and not enough to create a meaningful analysis. Therefore, we will consider dropping this dataset from our analysis.\n",
    "\n",
    "However, the grouping of sectors can still use in the global-level dataset, which we will consider using in our analysis if we can find ways to work with the data."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Global-level by fuel and sector"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 56,
   "metadata": {},
   "outputs": [],
   "source": [
    "data_path = ROOT + \"CEDS_v_2025_03_18_aggregate/\"\n",
    "bc = pd.read_csv(data_path + \"BC_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "ch4 = pd.read_csv(data_path + \"CH4_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "co2 = pd.read_csv(data_path + \"CO2_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "co = pd.read_csv(data_path + \"CO_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "n2o = pd.read_csv(data_path + \"N2O_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "nh3 = pd.read_csv(data_path + \"NH3_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "nmvoc = pd.read_csv(data_path + \"NMVOC_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "nox = pd.read_csv(data_path + \"NOx_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "oc = pd.read_csv(data_path + \"OC_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "so2 = pd.read_csv(data_path + \"SO2_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 57,
   "metadata": {},
   "outputs": [],
   "source": [
    "dfs = [bc, ch4, co2, co, n2o, nh3, nmvoc, nox, oc, so2]\n",
    "long_dfs = []\n",
    "for df in dfs:\n",
    "    year_cols = [col for col in df.columns if col.startswith('X')]\n",
    "    df = df.drop(columns='units')\n",
    "    df_long = df.melt(id_vars=['em', 'fuel', 'sector'],\n",
    "                      value_vars=year_cols,\n",
    "                      var_name='year', value_name='value')\n",
    "    df_long['year'] = df_long['year'].str[1:].astype(int)\n",
    "    long_dfs.append(df_long)\n",
    "\n",
    "ds3 = pd.concat(long_dfs, ignore_index=True)\n",
    "\n",
    "ds3 = ds3.pivot(\n",
    "          index=['year', 'fuel', 'sector'],\n",
    "          columns='em',\n",
    "          values='value'\n",
    "      ).reset_index()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 58,
   "metadata": {},
   "outputs": [],
   "source": [
    "def check_coverage(df):    \n",
    "    years = df['year'].unique()\n",
    "    sectors = df['sector'].unique()\n",
    "    fuel = df['fuel'].unique()\n",
    "\n",
    "    print(f\"Number of unique years: {len(years)}\")\n",
    "    print(f\"First year: {years.min()}\")\n",
    "    print(f\"Last year: {years.max()}\")\n",
    "    print(f\"Number of unique sectors: {len(sectors)}\")\n",
    "    print(f\"Number of unique fuel types: {len(fuel)}\")\n",
    "\n",
    "    full = pd.MultiIndex.from_product(\n",
    "        [fuel, years, sectors],\n",
    "        names=['fuel', 'year', 'sector']\n",
    "    ).to_frame(index=False)\n",
    "\n",
    "    missing = full.merge(\n",
    "        df[['fuel', 'year', 'sector']],\n",
    "        on=['fuel', 'year', 'sector'],\n",
    "        how='left',\n",
    "        indicator=True\n",
    "    )\n",
    "\n",
    "    missing = missing[missing['_merge'] == 'left_only'].drop(columns='_merge')\n",
    "\n",
    "    expected = len(full)\n",
    "    actual = len(df)\n",
    "    missing_count = len(missing)\n",
    "\n",
    "    print(\"\\n(contry, year, fuel) combinations\")\n",
    "    print(f\"Expected combinations: {expected}\")\n",
    "    print(f\"Actual combinations:   {actual}\")\n",
    "    print(f\"Missing combinations:  {missing_count}\")\n",
    "    print(f\"Coverage: {actual / expected * 100:.4f}%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 59,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of unique years: 274\n",
      "First year: 1750\n",
      "Last year: 2023\n",
      "Number of unique sectors: 62\n",
      "Number of unique fuel types: 9\n",
      "\n",
      "(contry, year, fuel) combinations\n",
      "Expected combinations: 152892\n",
      "Actual combinations:   68774\n",
      "Missing combinations:  84118\n",
      "Coverage: 44.9821%\n"
     ]
    }
   ],
   "source": [
    "check_coverage(ds3)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "##### Sector"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 60,
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_sector_group(sector):\n",
    "    if sector.startswith((\n",
    "        \"1A1a_\", \"1A1bc_\", \"1B1_\", \"1B2_\", \"1B2d_\", \"7A_\"\n",
    "    )):\n",
    "        return \"Energy production\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"1A2a_\", \"1A2b_\", \"1A2c_\", \"1A2d_\", \"1A2e_\", \"1A2f_\", \"1A2g_\", \"1A5_\",\n",
    "        \"2A1_\", \"2A2_\", \"2A6_\", \"2B_\", \"2C_\", \"2H_\", \"2L_\", \"6A_\"\n",
    "    )):\n",
    "        return \"Industry\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"1A3b_\", \"1A3c_\", \"1A3dii_\", \"1A3eii_\"\n",
    "    )):\n",
    "        return \"Transportation\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"1A4b_\", \"1A4a_\", \"1A4c_\"\n",
    "    )):\n",
    "        return \"Residential, commercial, other\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"2D_\", \"2D3_\"\n",
    "    )):\n",
    "        return \"Solvents\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"3B_\", \"3D_\", \"3I_\", \"3E_\"\n",
    "    )):\n",
    "        return \"Agriculture\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"5A_\", \"5E_\", \"5C_\", \"5D_\"\n",
    "    )):\n",
    "        return \"Waste\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"1A3di_\"\n",
    "    )):\n",
    "        return \"Shipping\"\n",
    "\n",
    "    else:\n",
    "        return \"Other\"\n",
    "\n",
    "ds3['sector_group'] = ds3['sector'].apply(get_sector_group)\n",
    "ds3 = ds3.groupby(['year', 'fuel', 'sector_group']).sum(numeric_only=True).reset_index()\n",
    "ds3.rename(columns={'sector_group': 'sector'}, inplace=True)"
   ]
  },
