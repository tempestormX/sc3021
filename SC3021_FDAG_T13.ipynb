   ],
   "source": [
    "# Extract year from date for aggregation\n",
    "temp_by_city['year'] = temp_by_city['dt'].dt.year\n",
    "\n",
    "# Aggregate monthly data to yearly averages by city\n",
    "# We group by Country, City, and year to maintain location granularity\n",
    "temp_yearly = temp_by_city.groupby(['Country', 'City', 'year']).agg({\n",
    "    'AverageTemperature': 'mean',\n",
    "}).reset_index()\n",
    "\n",
    "print(f\"Dataset shape after yearly aggregation: {temp_yearly.shape}\")\n",
    "print(f\"Original monthly records: {len(temp_by_city)}\")\n",
    "print(f\"Yearly aggregated records: {len(temp_yearly)}\")\n",
    "print(f\"\\nSample of yearly aggregated data:\")\n",
    "print(temp_yearly.head(10000))"
   ]
  },
