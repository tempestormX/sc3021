   "source": [
    "def train_lr(X_train, y_train, X_test, y_test):\n",
    "    # Train the model\n",
    "    model = LinearRegression()\n",
    "    model.fit(X_train, y_train)\n",
    "    preds = model.predict(X_test)\n",
    "    \n",
    "    # Evaluate the model\n",
    "    rmse = mean_squared_error(y_test, preds)\n",
    "    r2 = r2_score(y_test, preds)\n",
    "    \n",
    "    # Create a DataFrame of feature importance (coefficients)\n",
    "    imp_df = pd.DataFrame({\n",
    "        \"feature\": X_train.columns,\n",
    "        \"coefficient\": model.coef_\n",
    "    }).sort_values(by=\"coefficient\", key=abs, ascending=False)\n",
    "        \n",
    "    return model, rmse, r2, imp_df\n",
    "\n",
    "# Full model \n",
    "lr_full, rmse_full, r2_full, imp_full = train_lr(X_train, y_train, X_test, y_test)\n",
    "\n",
    "# Drop all lag features\n",
    "lag_cols = [c for c in X_train.columns if \"_lag\" in c]\n",
    "X_train_no_lag = X_train.drop(columns=lag_cols)\n",
    "X_test_no_lag = X_test.drop(columns=lag_cols)\n",
    "lr_no_lag, rmse_no_lag, r2_no_lag, imp_no_lag = train_lr(X_train_no_lag, y_train, X_test_no_lag, y_test)"
   ]
