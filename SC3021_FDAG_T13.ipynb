    "    print(f\"Number of unique sectors: {len(sectors)}\")\n",
    "    print(f\"Number of unique fuel types: {len(fuel)}\")\n",
    "\n",
    "    full = pd.MultiIndex.from_product(\n",
    "        [fuel, years, sectors],\n",
    "        names=['fuel', 'year', 'sector']\n",
    "    ).to_frame(index=False)\n",
    "\n",
    "    missing = full.merge(\n",
    "        df[['fuel', 'year', 'sector']],\n",
    "        on=['fuel', 'year', 'sector'],\n",
    "        how='left',\n",
    "        indicator=True\n",
    "    )\n",
    "\n",
    "    missing = missing[missing['_merge'] == 'left_only'].drop(columns='_merge')\n",
    "\n",
    "    expected = len(full)\n",
    "    actual = len(df)\n",
    "    missing_count = len(missing)\n",
    "\n",
    "    print(\"\\n(contry, year, fuel) combinations\")\n",
    "    print(f\"Expected combinations: {expected}\")\n",
    "    print(f\"Actual combinations:   {actual}\")\n",
    "    print(f\"Missing combinations:  {missing_count}\")\n",
    "    print(f\"Coverage: {actual / expected * 100:.4f}%\")"
   ]
