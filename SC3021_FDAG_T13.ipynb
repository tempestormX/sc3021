    "co2 = pd.read_csv(data_path + \"CO2_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "co = pd.read_csv(data_path + \"CO_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "n2o = pd.read_csv(data_path + \"N2O_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "nh3 = pd.read_csv(data_path + \"NH3_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "nmvoc = pd.read_csv(data_path + \"NMVOC_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "nox = pd.read_csv(data_path + \"NOx_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "oc = pd.read_csv(data_path + \"OC_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")\n",
    "so2 = pd.read_csv(data_path + \"SO2_CEDS_global_estimates_by_sector_fuel_v_2025_03_18.csv\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "dfs = [bc, ch4, co2, co, n2o, nh3, nmvoc, nox, oc, so2]\n",
    "long_dfs = []\n",
    "for df in dfs:\n",
    "    year_cols = [col for col in df.columns if col.startswith('X')]\n",
    "    df = df.drop(columns='units')\n",
    "    df_long = df.melt(id_vars=['em', 'fuel', 'sector'],\n",
    "                      value_vars=year_cols,\n",
    "                      var_name='year', value_name='value')\n",
    "    df_long['year'] = df_long['year'].str[1:].astype(int)\n",
    "    long_dfs.append(df_long)\n",
    "\n",
    "ds3 = pd.concat(long_dfs, ignore_index=True)\n",
    "\n",
    "ds3 = ds3.pivot(\n",
    "          index=['year', 'fuel', 'sector'],\n",
    "          columns='em',\n",
    "          values='value'\n",
    "      ).reset_index()"
   ]
