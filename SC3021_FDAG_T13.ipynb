    "coverage_data = temp_country_yearly_final[temp_country_yearly_final['Country'].isin(top_countries)]\n",
    "coverage_pivot = coverage_data.pivot_table(\n",
    "    index='Country',\n",
    "    columns='year',\n",
    "    values='AverageTemperature',\n",
    "    aggfunc='count'\n",
    ")\n",
    "\n",
    "# Plot heatmap for recent years (1950-2013)\n",
    "plt.figure(figsize=(16, 10))\n",
    "recent_years = coverage_pivot.loc[:, 1950:2013]\n",
    "im = plt.imshow(recent_years.values, aspect='auto', cmap='YlGn', interpolation='nearest')\n",
    "plt.colorbar(im, label='Data Availability')\n",
    "plt.yticks(range(len(recent_years.index)), recent_years.index)\n",
    "plt.xticks(range(0, len(recent_years.columns), 10), recent_years.columns[::10])\n",
    "plt.xlabel('Year', fontsize=12)\n",
    "plt.ylabel('Country', fontsize=12)\n",
    "plt.title('DS1 Data Coverage Heatmap (1950-2013) - Top 30 Countries', fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
  {
