   "source": [
    "def get_sector_group(sector):\n",
    "    if sector.startswith((\n",
    "        \"1A1a_\", \"1A1bc_\", \"1B1_\", \"1B2_\", \"1B2d_\", \"7A_\"\n",
    "    )):\n",
    "        return \"Energy production\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"1A2a_\", \"1A2b_\", \"1A2c_\", \"1A2d_\", \"1A2e_\", \"1A2f_\", \"1A2g_\", \"1A5_\",\n",
    "        \"2A1_\", \"2A2_\", \"2A6_\", \"2B_\", \"2C_\", \"2H_\", \"2L_\", \"6A_\"\n",
    "    )):\n",
    "        return \"Industry\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"1A3b_\", \"1A3c_\", \"1A3dii_\", \"1A3eii_\"\n",
    "    )):\n",
    "        return \"Transportation\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"1A4b_\", \"1A4a_\", \"1A4c_\"\n",
    "    )):\n",
    "        return \"Residential, commercial, other\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"2D_\", \"2D3_\"\n",
    "    )):\n",
    "        return \"Solvents\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"3B_\", \"3D_\", \"3I_\", \"3E_\"\n",
    "    )):\n",
    "        return \"Agriculture\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"5A_\", \"5E_\", \"5C_\", \"5D_\"\n",
    "    )):\n",
    "        return \"Waste\"\n",
    "\n",
    "    elif sector.startswith((\n",
    "        \"1A3di_\"\n",
    "    )):\n",
    "        return \"Shipping\"\n",
    "\n",
    "    else:\n",
    "        return \"Other\"\n",
    "\n",
    "ds3['sector_group'] = ds3['sector'].apply(get_sector_group)\n",
    "ds3 = ds3.groupby(['year', 'fuel', 'sector_group']).sum(numeric_only=True).reset_index()\n",
    "ds3.rename(columns={'sector_group': 'sector'}, inplace=True)"
   ]
