   "source": [
    "### Plot 1: Voltility Time Series for Top 5 Most Volatile Countries\n",
    "\n",
    "top5_volatile_countries = country_volatility.head(5).index\n",
    "df_volatile = ds_country[ds_country['country'].isin(top5_volatile_countries)]\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "sns.lineplot(data=df_volatile, x='year', y='AvgTemp', hue='country', marker='o')\n",
    "\n",
