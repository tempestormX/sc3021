    "## Plot 4: Country Share of Global Emissions Over Time (Area Chart)\n",
    "\n",
    "def plot_country_emission_shares(ds_country):\n",
    "    \"\"\"\n",
    "    Calculates and plots the country share of global emissions over time.\n",
    "    Groups the Top 5 CO2 emitters individually and bins the rest into 'Rest of World'.\n",
    "    \"\"\"\n",
    "    # 1. Define the gases to analyze\n",
    "    gases = ['BC', 'CH4', 'CO', 'CO2', 'N2O', 'NH3', 'NMVOC', 'NOx', 'OC', 'SO2']\n",
    "\n",
    "    # 2. Melt the data from wide to long\n",
    "    long = ds_country.melt(\n",
    "        id_vars=[\"country\", \"year\"],\n",
    "        value_vars=gases,\n",
    "        var_name=\"gas\",\n",
    "        value_name=\"emission\"\n",
    "    )\n",
    "    # Treat 0 as NaN to avoid skewing data\n",
    "    long[\"emission\"] = long[\"emission\"].replace(0, np.nan)\n",
    "\n",
    "    # 3. Calculate Global Totals per gas and year\n",
    "    global_tot = (\n",
    "        long.groupby([\"gas\", \"year\"], as_index=False)[\"emission\"]\n",
    "        .sum(min_count=1)\n",
    "        .rename(columns={\"emission\": \"global_emission\"})\n",
    "    )\n",
    "\n",
    "    # 4. Merge and compute the exact ratio (Country Emission / Global Emission)\n",
    "    long = long.merge(global_tot, on=[\"gas\", \"year\"])\n",
    "    long = long[long[\"global_emission\"].notna() & (long[\"global_emission\"] > 0)].copy()\n",
    "    long[\"ratio\"] = (long[\"emission\"] / long[\"global_emission\"]).fillna(0)\n",
    "\n",
    "    # 5. Isolate the Top 5 CO2 emitters to keep the chart readable\n",
    "    top_5 = ds_country.groupby('country')['CO2'].sum().nlargest(5).index.tolist()\n",
    "\n",
    "    # Create a new column that bins smaller emitters into 'Rest of World'\n",
    "    long['region_group'] = long['country'].apply(lambda c: c if c in top_5 else 'Rest of World')\n",
    "\n",
    "    # Aggregate the ratios by this new grouping\n",
    "    grouped_ratio = long.groupby(['region_group', 'year', 'gas'], as_index=False)['ratio'].sum()\n",
    "\n",
    "    # 6. Dynamic Plotting Setup\n",
    "    n = len(gases)\n",
    "    ncols = 3\n",
    "    nrows_plot = math.ceil(n / ncols)\n",
    "    \n",
    "    fig, axs = plt.subplots(nrows_plot, ncols, figsize=(ncols * 8, nrows_plot * 5), squeeze=False)\n",
    "    axs = axs.flatten()\n",
    "\n",
    "    # Define a consistent stacking order (Rest of World at the bottom, then Top 5)\n",
    "    plot_order = ['Rest of World'] + top_5\n",
    "\n",
    "    # 7. Generate Area Charts\n",
    "    for i, gas in enumerate(gases):\n",
    "        df_g = grouped_ratio[grouped_ratio[\"gas\"] == gas].copy()\n",
    "\n",
    "        # Pivot to get years as rows and regions as columns\n",
    "        pivot = df_g.pivot(index=\"year\", columns=\"region_group\", values=\"ratio\").fillna(0)\n",
    "\n",
    "        # Reorder columns to ensure colors match across all subplots\n",
    "        available_cols = [c for c in plot_order if c in pivot.columns]\n",
    "        pivot = pivot[available_cols]\n",
    "\n",
    "        ax = axs[i]\n",
    "        pivot.plot.area(ax=ax, linewidth=0.5, alpha=0.85)\n",
    "\n",
    "        ax.set_title(f\"{gas}: Country Share of Global Total\", fontsize=12, fontweight='bold')\n",
    "        ax.set_xlabel(\"Year\")\n",
    "        ax.set_ylabel(\"Global Share (0 to 1)\")\n",
    "        ax.set_ylim(0, 1)\n",
    "        ax.margins(x=0)\n",
    "        ax.grid(True, alpha=0.3)\n",
    "\n",
    "        # Clean legend handling\n",
    "        if i == n-1:\n",
    "            ax.legend(title=\"Region\", loc=\"center left\", bbox_to_anchor=(1, 0.5), fontsize=\"small\")\n",
    "        else:\n",
    "            legend = ax.get_legend()\n",
    "            if legend:\n",
    "                legend.remove()\n",
    "\n",
    "    # --- THESE LINES WERE FIXED (Indented to be inside the function) ---\n",
    "    for j in range(n, len(axs)):\n",
    "        axs[j].axis(\"off\")\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "plot_country_emission_shares(ds_country)"
   ]
  },
