   "source": [
    "To find out who is the current highest contributor to climate change factors, we would obtain a general score, using both the Random Forest Scores in the Data Analysis for ds_country, as well as the percentages of atmospheric gas emissions for each country. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "\n",
    "# --- Step 1: Aggregate Total Emissions by Country ---\n",
    "# Group by country and sum all historical emissions for the 10 gases\n",
    "country_emissions = ds_country.groupby('country')[gas_cols].sum()\n",
    "\n",
    "# --- Step 2: Calculate Global Totals ---\n",
    "# Sum across all countries to get the absolute global total for each gas\n",
    "global_totals = country_emissions.sum()\n",
    "\n",
    "# --- Step 3: Calculate Percentage Share ---\n",
    "# Divide each country's emissions by the global total (results in 0.0 to 1.0)\n",
    "country_pct = country_emissions.div(global_totals)\n",
    "\n",
    "# --- Step 4: Multiply by the Base Composite Score ---\n",
    "# Extract the Base_Composite series from your previous final_priority dataframe\n",
    "base_scores = final_priority['Base_Composite']\n",
    "\n",
    "# Multiply the percentages by the base scores\n",
    "country_weighted = country_pct.mul(base_scores)\n",
    "\n",
    "# --- Step 5: Sum the Weighted Scores ---\n",
    "# Add the scores across all 10 gas columns to get a single total score per country\n",
    "country_weighted['Total_Impact_Score'] = country_weighted.sum(axis=1)\n",
    "\n",
    "# --- Step 6: Identify the Top 3 Countries ---\n",
    "# Sort descending and grab the top 3\n",
    "top_3_impact = country_weighted.sort_values('Total_Impact_Score', ascending=False).head(3)\n",
    "\n",
    "print(\"Top 3 Countries by Temperature-Increasing Emission Impact:\")\n",
    "print(\"-\" * 60)\n",
    "print(top_3_impact[['Total_Impact_Score']])\n",
    "\n",
    "# (Optional) Show exactly how those top 3 achieved their score across the gases\n",
    "print(\"\\nDetailed Breakdown for Top 3:\")\n",
    "print(top_3_impact)"
