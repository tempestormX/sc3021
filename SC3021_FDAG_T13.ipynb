    "data_path = ROOT + \"CEDS_v_2025_03_18_aggregate/\"\n",
    "bc = pd.read_csv(data_path + \"BC_CEDS_estimates_by_country_sector_v_2025_03_18.csv\")\n",
    "ch4 = pd.read_csv(data_path + \"CH4_CEDS_estimates_by_country_sector_v_2025_03_18.csv\")\n",
    "co2 = pd.read_csv(data_path + \"CO2_CEDS_estimates_by_country_sector_v_2025_03_18.csv\")\n",
    "co = pd.read_csv(data_path + \"CO_CEDS_estimates_by_country_sector_v_2025_03_18.csv\")\n",
    "n2o = pd.read_csv(data_path + \"N2O_CEDS_estimates_by_country_sector_v_2025_03_18.csv\")\n",
    "nh3 = pd.read_csv(data_path + \"NH3_CEDS_estimates_by_country_sector_v_2025_03_18.csv\")\n",
    "nmvoc = pd.read_csv(data_path + \"NMVOC_CEDS_estimates_by_country_sector_v_2025_03_18.csv\")\n",
    "nox = pd.read_csv(data_path + \"NOx_CEDS_estimates_by_country_sector_v_2025_03_18.csv\")\n",
    "oc = pd.read_csv(data_path + \"OC_CEDS_estimates_by_country_sector_v_2025_03_18.csv\")\n",
    "so2 = pd.read_csv(data_path + \"SO2_CEDS_estimates_by_country_sector_v_2025_03_18.csv\")"
   ]
