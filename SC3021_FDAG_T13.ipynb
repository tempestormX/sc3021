   "metadata": {},
   "source": [
    "##### Geospatial Visualization"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "This geospatial visualization show world map with countries colored according to their average temperature, temperatue anomaly, and all types of emissions. This allows us to visually identify geographical patterns and hotspots in temperature and emissions, which can provide insights into regional climate impacts and the distribution of pollution sources."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df = ds_country.copy()\n",
    "\n",
    "url = \"https://naturalearth.s3.amazonaws.com/110m_cultural/ne_110m_admin_0_countries.zip\"\n",
    "world = gpd.read_file(url)\n",
    "world['ISO_A3'] = world['ISO_A3'].str.lower()\n",
    "\n",
    "df = df.sort_values(['ISO3', 'year'])\n",
    "\n",
    "first_temp = df.groupby('ISO3')['AvgTemp'].first()\n",
    "df['baseline_temp'] = df['ISO3'].map(first_temp)\n",
    "\n",
    "df['TempAnomaly'] = df['AvgTemp'] - df['baseline_temp']\n",
    "\n",
    "df['TotalEmissions'] = np.log1p(df[gas_cols].clip(lower=0)).sum(axis=1)\n",
    "\n",
    "variables = ['AvgTemp', 'TempAnomaly', 'TotalEmissions'] + gas_cols\n",
    "\n",
    "global_min = df[variables][df[variables] > 0].min() \n",
    "global_max = df[variables].max()\n",
    "\n",
    "def plot_map(year, variable, log_scale=False):\n",
    "    plt.close('all')  # prevent duplicate plots\n",
    "\n",
    "    df_year = df[df['year'] == year]\n",
    "\n",
    "    merged = world.merge(df_year, left_on='ISO_A3', right_on='ISO3', how='left')\n",
    "\n",
    "    # Temperature anomaly \n",
    "    if variable == 'TempAnomaly':\n",
    "        cmap = 'RdBu_r'\n",
    "        vmin = -5\n",
    "        vmax = 5\n",
    "\n",
    "    # Emissions (log scale option)\n",
    "    elif variable in gas_cols + ['TotalEmissions']:\n",
    "        cmap = 'plasma_r'\n",
    "        if log_scale and variable != 'TotalEmissions':\n",
    "            merged[variable] = np.log1p(merged[variable])\n",
    "            vmin = np.log1p(global_min[variable])\n",
    "            vmax = np.log1p(global_max[variable])\n",
    "        else:\n",
    "            vmin = global_min[variable]\n",
    "            vmax = global_max[variable]\n",
    "\n",
    "    # Normal variables\n",
    "    else:\n",
    "        cmap = 'coolwarm'\n",
    "        vmin = global_min[variable]\n",
    "        vmax = global_max[variable]\n",
    "\n",
    "    fig, ax = plt.subplots(1, 1, figsize=(20, 8))\n",
    "\n",
    "    merged.plot(\n",
    "        column=variable,\n",
    "        cmap=cmap,\n",
    "        linewidth=0.5,\n",
    "        ax=ax,\n",
    "        edgecolor='black',\n",
    "        legend=True,\n",
    "        vmin=vmin,\n",
    "        vmax=vmax,\n",
    "        missing_kwds={\n",
    "            \"color\": \"lightgrey\",\n",
    "            \"label\": \"Missing\"\n",
    "        }\n",
    "    )\n",
    "\n",
    "    # Better title\n",
    "    if variable == 'TempAnomaly':\n",
    "        title = f\"Temperature Change Since First Year ({year})\"\n",
    "    else:\n",
    "        title = f\"{variable} in {year}\"\n",
    "\n",
    "    ax.set_title(title, fontsize=16)\n",
    "    ax.axis('off')\n",
    "\n",
    "    plt.show()\n",
    "\n",
    "# Widgets\n",
    "year_slider = widgets.IntSlider(\n",
    "    value=int(df['year'].min()),\n",
    "    min=int(df['year'].min()),\n",
    "    max=int(df['year'].max()),\n",
    "    step=1,\n",
    "    description='Year:',\n",
    "    continuous_update=False\n",
    ")\n",
    "\n",
    "variable_dropdown = widgets.Dropdown(\n",
    "    options=variables,\n",
    "    value='AvgTemp',\n",
    "    description='Variable:'\n",
    ")\n",
    "\n",
    "log_checkbox = widgets.Checkbox(\n",
    "    value=False,\n",
    "    description='Log scale (for emissions)'\n",
    ")\n",
    "\n",
    "play = widgets.Play(\n",
    "    interval=200,\n",
    "    value=year_slider.min,\n",
    "    min=year_slider.min,\n",
    "    max=year_slider.max,\n",
    "    step=1,\n",
    "    description=\"▶\"\n",
    ")\n",
    "\n",
    "widgets.jslink((play, 'value'), (year_slider, 'value'))\n",
    "\n",
    "ui = widgets.VBox([\n",
    "    widgets.HBox([year_slider, play]),\n",
    "    variable_dropdown,\n",
    "    log_checkbox\n",
    "])\n",
    "\n",
    "out = widgets.interactive_output(\n",
    "    plot_map,\n",
    "    {\n",
    "        'year': year_slider,\n",
    "        'variable': variable_dropdown,\n",
    "        'log_scale': log_checkbox\n",
    "    }\n",
    ")\n",
    "\n",
    "display(ui, out)"
   ]
  },
