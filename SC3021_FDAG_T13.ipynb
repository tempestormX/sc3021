   "source": [
    "from sklearn.preprocessing import StandardScaler, MinMaxScaler\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "gas_cols = ['BC', 'CH4', 'CO2', 'CO', 'N2O', 'NH3', 'NMVOC', 'NOx', 'OC', 'SO2']\n",
    "\n",
    "# --- Step 1: Pearson Correlation ---\n",
    "correlations = {}\n",
    "for gas in gas_cols:\n",
    "    corr = ds_country[gas].corr(ds_country['AvgTemp'])\n",
    "    correlations[gas] = abs(corr) \n",
    "\n",
    "corr_df = pd.DataFrame.from_dict(correlations, orient='index', columns=['Abs_Correlation'])\n",
    "corr_df['Corr_Rank'] = corr_df['Abs_Correlation'].rank(ascending=True)\n",
    "\n",
    "# --- Data Preparation ---\n",
    "X = ds_country[gas_cols].fillna(0)\n",
    "y = ds_country['AvgTemp']\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "\n",
    "# --- Step 2: Random Forest Feature Importance ---\n",
    "rf = RandomForestRegressor(n_estimators=100, random_state=42)\n",
    "rf.fit(X_scaled, y)\n",
    "\n",
    "rf_df = pd.DataFrame({\n",
    "    'Gas': gas_cols,\n",
    "    'RF_Importance': rf.feature_importances_\n",
    "}).set_index('Gas')\n",
    "rf_df['RF_Rank'] = rf_df['RF_Importance'].rank(ascending=True)\n",
    "\n",
    "# --- Step 3: Calculate & Normalize Total Emissions ---\n",
    "# 1. Get the sum of all emissions for each gas\n",
    "total_emissions = ds_country[gas_cols].sum()\n",
    "emission_df = pd.DataFrame({'Total_Emission': total_emissions})\n",
    "\n",
    "# 2. Scale the raw emissions down to a 0.0 - 1.0 range so it acts as a fair multiplier\n",
    "min_max = MinMaxScaler()\n",
    "emission_df['Emission_Multiplier'] = min_max.fit_transform(emission_df[['Total_Emission']])\n",
    "\n",
    "# --- Step 4: Volume-Adjusted Priority Score ---\n",
    "final_priority = corr_df[['Corr_Rank']].join(rf_df['RF_Rank']).join(emission_df)\n",
    "\n",
    "# Calculate the original base composite (average of the two statistical ranks)\n",
    "final_priority['Base_Composite'] = final_priority[['Corr_Rank', 'RF_Rank']].mean(axis=1)\n",
    "\n",
    "# Multiply by the emission factor. \n",
    "# We do (1 + Multiplier) so the lowest emitted gas (0.0) retains its base score (Base * 1), \n",
    "# and the highest emitted gas (1.0) gets a 100% boost to its score (Base * 2).\n",
    "final_priority['Volume_Adjusted_Score'] = final_priority['Base_Composite'] * (1 + final_priority['Emission_Multiplier'])\n",
    "\n",
    "# Sort by the new adjusted score\n",
    "final_priority = final_priority.sort_values('Volume_Adjusted_Score', ascending=False)\n",
    "\n",
    "# --- Visualisation ---\n",
    "plt.figure(figsize=(12, 6))\n",
    "bars = plt.barh(final_priority.index, final_priority['Volume_Adjusted_Score'], color='coral')\n",
    "plt.gca().invert_yaxis()\n",
    "plt.xlabel('Volume-Adjusted Priority Score')\n",
    "plt.title('Gas Prioritisation: Statistical Importance Weighted by Emission Volume')\n",
    "plt.grid(axis='x', alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Print the final breakdown so you can see the math in action\n",
    "print(final_priority[['Base_Composite', 'Total_Emission', 'Emission_Multiplier', 'Volume_Adjusted_Score']])"
   ]
